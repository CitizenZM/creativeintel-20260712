generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  DRAFT
  RESEARCHING
  ANALYZED
  GENERATING
  COMPLETE
  ERROR
}

enum DataSource {
  OFFICIAL_API
  PUBLIC_WEB
  USER_INPUT
  AI_INFERRED
}

enum ContentType {
  YOUTUBE_VIDEO
  YOUTUBE_SHORT
  TIKTOK_VIDEO
  VIMEO_VIDEO
  WEBSITE_PAGE
  SOCIAL_POST
  WEB_MENTION
  REVIEW
  META_AD
  TIKTOK_AD
  GOOGLE_AD
  INSTAGRAM_REEL
}

enum NarrativeType {
  PROBLEM_SOLUTION
  TESTIMONIAL
  DEMONSTRATION
  LIFESTYLE
  EDUCATIONAL
  COMPARISON
  STORY_ARC
  UGC_STYLE
  TREND_RIDING
  BEFORE_AFTER
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brands      BrandProfile[]
  competitors CompetitorProfile[]
  projects    Project[]
}

model BrandProfile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name             String
  url              String?
  category         String?
  brandPromise     String?
  valueProposition String?
  toneOfVoice      String?
  targetAudience   String?
  pricingTheme     String?
  productFeatures  Json?
  ctaLanguage      Json?
  socialProof      Json?

  lastCrawledAt DateTime?
  rawCrawlData  Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  projects Project[]
  brands   Brand[]

  @@unique([workspaceId, name])
  @@index([workspaceId, lastCrawledAt])
}

model CompetitorProfile {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  name             String
  url              String?
  brandPromise     String?
  valueProposition String?
  toneOfVoice      String?
  pricingTheme     String?
  productFeatures  Json?
  ctaLanguage      Json?
  socialProof      Json?
  strengths        Json?
  weaknesses       Json?

  lastCrawledAt DateTime?
  rawCrawlData  Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  competitors Competitor[]

  @@unique([workspaceId, name])
  @@index([workspaceId, lastCrawledAt])
}

model CrawlCache {
  id            String   @id @default(cuid())
  cacheKey      String   @unique
  kind          String
  schemaVersion Int      @default(1)
  payload       Json
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([kind, expiresAt])
  @@index([expiresAt])
}

model IdempotencyKey {
  key       String   @id
  route     String
  projectId String?
  response  Json
  status    Int      @default(200)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([projectId, route])
  @@index([expiresAt])
}

model Project {
  id        String        @id @default(cuid())
  name      String
  status    ProjectStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  workspaceId    String?
  workspace      Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  brandProfileId String?
  brandProfile   BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  brandName    String
  brandUrl     String?
  category     String?
  campaignGoal String?
  // The creative intent that steers ranking, style picks and templates:
  // storytelling | conversion | hybrid (see src/lib/style-categories.ts).
  goalType     String?
  // What the last complete analysis was run over (see insights/reanalyze) —
  // Re-analyze skips work when nothing has changed since.
  analysisFingerprint String?

  // LibTV canvas this project's studio runs render into (bound once, reused).
  libtvCanvasUuid String?

  // Set to hide a finished or abandoned project from the default lists.
  archivedAt DateTime?

  // Product definition — user-specified, foundational source of truth
  productUrl        String? // specific product page URL (Amazon PDP, DTC page)
  productName       String? // exact product name entered by user
  productPageTitle  String? // scraped from productUrl
  productPageImages Json? // [{url, alt, width?, height?}] real images from productUrl
  productPageText   String? @db.Text // scraped product description from productUrl
  userProductImages Json? // [{url, caption, uploadedAt}] user-uploaded reference photos
  // Set once a person has checked the product details (scraped details start
  // unconfirmed; every script and render is held to them).
  productConfirmedAt DateTime?

  briefingText   String?
  briefingParsed String?

  brandHealthScore Float?
  opportunityScore Float?
  topSignals       Json?

  brand             Brand?
  competitors       Competitor[]
  contentAssets     ContentAsset[]
  insights          Insight[]
  narrativePatterns NarrativePattern[]
  sellingPoints     SellingPoint[]
  angles            Angle[]
  jobs              Job[]
  scripts           Script[]
  storyboards       Storyboard[]
  creativeVariants  CreativeVariant[]
  previewAssets     PreviewAsset[]
  researchJobs      ResearchJob[]
  audienceProfile   AudienceProfile?
  deepAnalysis      DeepAnalysis?
  campaignSelection CampaignSelection?
  renderJobs        RenderJob[]
  videoReferences   VideoReference[]
  falVideoJobs      FalVideoJob[]
  brandKit          BrandKit?
  adTeardowns       AdTeardown[]
  competitorRollups CompetitorRollup[]
  libtvRuns         LibtvRun[]
}

model Brand {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  brandProfileId String?
  brandProfile   BrandProfile? @relation(fields: [brandProfileId], references: [id], onDelete: SetNull)

  name             String
  url              String?
  brandPromise     String?
  valueProposition String?
  toneOfVoice      String?
  targetAudience   String?
  pricingTheme     String?
  socialProof      Json?
  ctaLanguage      Json?
  productFeatures  Json?

  // Product Intelligence — added for visual verification system
  productCategory    String? // e.g., "Home Appliances - Vacuum Cleaners"
  productDescription String? @db.Text // precise product description for AI
  productImages      Json? // [{url, caption, type: "product"|"in-use"|"environment"}]
  useEnvironments    Json? // [{name, description, imagePrompt, sampleImageUrl}]
  actorSettings      Json? // [{role, ageRange, scenario, visualDescription}]
  displayGuidelines  Json? // [{rule, example, antiExample}]
  productVerified    Boolean @default(false)

  dataSource   DataSource @default(AI_INFERRED)
  rawCrawlData Json?
  createdAt    DateTime   @default(now())
}

model Competitor {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  competitorProfileId String?
  competitorProfile   CompetitorProfile? @relation(fields: [competitorProfileId], references: [id], onDelete: SetNull)

  name             String
  url              String?
  brandPromise     String?
  valueProposition String?
  toneOfVoice      String?
  pricingTheme     String?
  productFeatures  Json?
  ctaLanguage      Json?
  socialProof      Json?
  strengths        Json?
  weaknesses       Json?

  contentAssets ContentAsset[]
  adTeardowns   AdTeardown[]
  rollup        CompetitorRollup?
  insights      Insight[]

  dataSource   DataSource @default(AI_INFERRED)
  rawCrawlData Json?
  // Removed by the user: skipped by research, hidden from lists and analysis.
  excluded     Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model ContentAsset {
  id           String      @id @default(cuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  competitorId String?
  competitor   Competitor? @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  type         ContentType
  title        String
  url          String
  thumbnailUrl String?
  description  String?
  publishedAt  DateTime?
  platform     String?

  viewCount      Int?
  likeCount      Int?
  commentCount   Int?
  engagementRate Float?
  metricsSource  DataSource @default(AI_INFERRED)

  overallScore      Float?
  hookStrength      Float?
  productVisibility Float?
  storytellingArc   Float?
  ctaQuality        Float?
  emotionalAppeal   Float?
  pacing            Float?

  hookText        String?
  narrativeType   NarrativeType?
  contentCategory String?
  keyMessages     Json?
  transcript      String?

  isBrandOwned    Boolean @default(false)
  isPaidMedia     Boolean @default(false)
  adSpendEstimate Json?

  // Ad-candidate provenance & format (populated by research adapters)
  adSource       String? // meta_ad_library | tiktok_ad_library | tiktok_cc | google_ats | youtube | ig_reels | ddg
  adEvidence     String? // ad_library | paid_label | classifier | none
  adConfidence   Float? // 0..1 — classifier confidence that this is a brand-paid ad
  advertiserName String?
  advertiserId   String?
  adLibraryId    String?
  durationSec    Float?
  aspectRatio    String? // 9:16 | 1:1 | 16:9 | 4:5
  format         String? // vertical_short | square | horizontal | unknown
  videoUrl       String? // direct media URL when known (ad library snapshot / worker capture)
  landingUrl     String?
  firstSeenAt    DateTime?
  lastSeenAt     DateTime?
  frameUrls      Json? // string[] — extracted keyframes for vision teardown
  rankInOwner    Int? // Top-N rank within its competitor (or brand) after ranking
  // User curation: excluded ads are hidden and never analysed; pinned ads are
  // always torn down and shown first.
  excluded       Boolean @default(false)
  pinned         Boolean @default(false)

  dataSource DataSource @default(OFFICIAL_API)
  rawData    Json?
  createdAt  DateTime   @default(now())

  insights Insight[]
  teardown AdTeardown?

  @@unique([projectId, url])
  @@index([projectId, type])
  @@index([projectId, overallScore])
  @@index([projectId, isPaidMedia])
  @@index([projectId, competitorId, rankInOwner])
}

// Per-ad structured teardown — deep tier only (Top-N per competitor).
model AdTeardown {
  id             String       @id @default(cuid())
  projectId      String
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentAssetId String       @unique
  contentAsset   ContentAsset @relation(fields: [contentAssetId], references: [id], onDelete: Cascade)
  competitorId   String?
  competitor     Competitor?  @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  rank          Int?
  hookType      String
  hookText      String
  hookVisual    String
  beats         Json // [{startSec,endSec,role,visual,vo,onScreenText}]
  sellingPoints Json // [{point, evidenceTimestamp}]
  proofDevices  Json // [{type, description, timestamp}]
  ctaText       String?
  ctaPlacement  String? // end_card | mid_roll | persistent_overlay
  offer         String?
  landingUrl    String?
  whyItWorks    String  @db.Text
  evidenceLevel String // vision_transcript | transcript | thumbnail | metadata
  confidence    String // high | medium | low
  promptVersion Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, competitorId, rank])
}

// Per-competitor rollup of its Top-N teardowns.
model CompetitorRollup {
  id           String     @id @default(cuid())
  projectId    String
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  competitorId String     @unique
  competitor   Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  topAssetIds     Json // string[]
  dominantHooks   Json
  dominantFormats Json
  offerLadder     Json
  ctaPatterns     Json
  cadence         Json
  summary         String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Insight {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentAssetId String?
  contentAsset   ContentAsset? @relation(fields: [contentAssetId], references: [id], onDelete: SetNull)
  competitorId   String?
  competitor     Competitor?   @relation(fields: [competitorId], references: [id], onDelete: SetNull)

  category       String
  title          String
  description    String
  importance     Float?
  evidence       Json?
  recommendation String?

  dataSource DataSource @default(AI_INFERRED)
  // Sent to script context by the user; read by angle and script generation.
  selected   Boolean    @default(false)
  createdAt  DateTime   @default(now())

  @@index([projectId, category])
  @@index([projectId, competitorId])
}

model NarrativePattern {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  type           NarrativeType
  name           String
  description    String
  frequency      Int           @default(0)
  avgPerformance Float?
  examples       Json?
  bestPractices  Json?
  selected       Boolean       @default(false)
  dismissed      Boolean       @default(false) // marked "not relevant" — hidden and ignored by generation

  createdAt DateTime @default(now())

  @@unique([projectId, type])
}

model SellingPoint {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  point           String
  category        String
  strength        Float?
  frequency       Int     @default(0)
  competitorUsage Boolean @default(false)
  uniqueness      Float?
  selected        Boolean @default(false)
  dismissed       Boolean @default(false)
  addedByUser     Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([projectId, category])
}

model Script {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  title              String
  angle              String
  format             String
  duration           String
  platform           String?
  totalDurationSec   Int?
  hookVariants       Json
  body               String
  ctaVariants        Json
  narrativeType      NarrativeType?
  targetEmotion      String?
  predictedScore     Float?
  scenes             Json? // [{sceneNumber, startSec, endSec, segmentLabel, shotType, focalLength, cameraMovement, aperture, location, lighting, actorAction, productAction, voiceover, textOverlay, transition}]
  platformTechniques Json? // string[] — platform-playbook techniques applied (e.g. "native text overlay in frame 1")

  // Structured script (v2) — see src/services/ai/prompts/script-templates.ts
  videoType String? // PRODUCT_INTRO | PROMO_OFFER | AWARENESS_INTEREST
  template  String? // ScriptTemplate id, e.g. PROBLEM_AGITATE_SOLVE
  hook      Json? // {text, visual, shot, durationSec, hookFormula}
  bodyBeats Json? // [{beat, sellingPoint, howExpressed, shot, startSec, endSec, voiceover, textOverlay, proof}]
  cta       Json? // {text, offer, urgency, visual, shot, durationSec}

  // The user's pick of which scripts go on to storyboards and Studio. Kept on
  // the row so the choice survives a reload instead of living in page state.
  status    String    @default("draft") // draft | selected
  deletedAt DateTime? // archived — hidden from lists, never hard-deleted

  // The user's picks among the generated options, carried into the storyboard.
  selectedHookIdx Int? // index into hookVariants
  selectedCtaIdx  Int? // index into ctaVariants
  roleName        String? // Brand.actorSettings[].role cast for this script
  environmentName String? // Brand.useEnvironments[].name used as its setting

  createdAt DateTime @default(now())

  @@index([projectId, videoType])
  @@index([projectId, deletedAt])
}

// A long-running AI operation (angles, scripts, storyboards, analysis). Runs
// server-side after the request returns, so progress survives a reload and
// every page reads the same shape: done/total, per-item steps, ETA.
model Job {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind        String // angles | scripts | storyboards | analysis
  status      String  @default("queued") // queued | running | completed | failed | cancelled
  total       Int     @default(0)
  done        Int     @default(0)
  failed      Int     @default(0)
  currentStep String?
  steps       Json? // [{key, label, status: queued|running|done|failed|cancelled, error?, resultId?}]
  input       Json?
  result      Json? // {ids: string[], failures: [{key,label,error}]}
  error       String?

  cancelRequested Boolean   @default(false)
  startedAt       DateTime?
  heartbeatAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([projectId, kind, createdAt])
}

// The LibTV credit balance as last read by a person from LibTV's top bar.
// Last time each local worker polled for work. The queue alone can't tell an
// idle worker from an offline one, and callers that block on the worker need
// to know which before waiting minutes for a result that will never come.
model WorkerHeartbeat {
  workerId   String   @id
  lastSeenAt DateTime @default(now())
}

// LibTV exposes no balance API, so the app tracks it: latest reading minus the
// credits every run has spent since it was recorded.
model LibtvBalance {
  id         String   @id @default(cuid())
  balance    Int
  note       String?
  recordedAt DateTime @default(now())
}

// One generated ad angle. Every generation is kept (grouped by batchId) so a
// regenerate never throws away angles the user already liked.
model Angle {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  batchId   String

  title          String
  description    String
  targetEmotion  String?
  narrativeType  String?
  videoType      String?
  templateIds    Json? // string[]
  predictedScore Float?
  rationale      String?
  targetAudience String?
  platform       String?

  status    String    @default("draft") // draft | selected
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([projectId, deletedAt])
  @@index([projectId, batchId])
}

model Storyboard {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scriptId  String?

  title         String
  frames        Json // GridFrame[] — one per 2s window, each tagged HOOK|BODY|CTA (src/lib/storyboard-grid.ts)
  totalDuration String?
  style         String?
  frameSeconds  Int     @default(2)

  // Regenerating a script's storyboard adds a new version rather than a
  // loose row; exactly one version per script is active (the one Studio uses).
  version      Int       @default(1)
  isActive     Boolean   @default(true)
  deletedAt    DateTime?
  frameHistory Json? // [{frameNumber, frame, editedAt}] — prior frame state, newest last

  createdAt DateTime @default(now())

  @@index([projectId, scriptId])
}

// ─── Brand Kit — the brand truth every generated ad must stay consistent with ──
model BrandKit {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  colorsHex       Json? // [{name, hex, usage: primary|secondary|accent|background}]
  fonts           Json? // [{role: headline|body, family, source}]
  ctaOptions      Json? // [{text, priority}] — approved CTA copy pool
  offerText       String?
  landingUrl      String?
  claimsAllowed   Json? // string[]
  claimsForbidden Json? // string[]
  toneGuidelines  String? @db.Text
  doNotShow       Json? // string[] — visual do-nots
  skuName         String?
  skuDimensionsCm Json? // {height, width, depth, weightG}
  productSummary  String? @db.Text // one-paragraph canonical description for prompts

  completenessScore Int          @default(0)
  assets            BrandAsset[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model BrandAsset {
  id         String   @id @default(cuid())
  brandKitId String
  brandKit   BrandKit @relation(fields: [brandKitId], references: [id], onDelete: Cascade)

  kind     String // LOGO | PACKSHOT | LIFESTYLE | FONT | OTHER
  variant  String? // light | dark | front | side | back | in-hand | transparent
  url      String
  publicId String? // storage provider id (Cloudinary public_id / blob path)
  provider String  @default("cloudinary")
  width    Int?
  height   Int?
  format   String?
  bytes    Int?
  verified Boolean @default(false)
  caption  String?

  createdAt DateTime @default(now())

  @@index([brandKitId, kind])
}

// ─── Generic local-worker tasks (browser-only research: ad libraries etc.) ────
model WorkerTask {
  id        String  @id @default(cuid())
  projectId String?
  kind      String // ad_library_fetch | video_probe | ...
  payload   Json
  priority  Int     @default(0)

  status      String    @default("queued") // queued|claimed|running|completed|failed
  result      Json?
  error       String?
  attempts    Int       @default(0)
  workerId    String?
  claimedAt   DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, kind, priority])
  @@index([projectId, kind])
}

// ─── LibTV production runs — executed by the local libtv-worker ───────────────
model LibtvRun {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scriptId     String?
  storyboardId String?

  status           String    @default("draft") // draft|awaiting_approval|approved|claimed|running|assembling|completed|failed|cancelled
  canvasUuid       String?
  canvasUrl        String?
  canvasName       String?
  imageModel       String    @default("Seedream 4.0")
  videoModel       String    @default("Hailuo 2.3 Fast")
  aspectRatio      String    @default("9:16")
  clipDurationSec  Int       @default(6)
  creditsEstimated Int       @default(0)
  creditsSpent     Int       @default(0)
  creditCap        Int?
  approvedAt       DateTime?
  masterMp4Url     String?
  // The deliverable for its script, picked by the user (one per script).
  isFinal          Boolean   @default(false)
  // Set when this run re-renders chosen scenes of an earlier run.
  parentRunId      String?
  previewMp4Url    String?
  contactSheetUrl  String?
  error            String?
  workerId         String?
  claimedAt        DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  jobs LibtvJob[]

  @@index([projectId, status])
  @@index([status])
}

model LibtvJob {
  id        String   @id @default(cuid())
  runId     String
  run       LibtvRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  projectId String

  shotIndex        Int // 0-based frame index this job serves (-1 for uploads)
  kind             String // upload | image | video
  nodeName         String // K3 / V3 / PROD-sku — unique on the canvas
  nodeId           String?
  leftRefs         Json? // string[] — upstream node names (e.g. ["PROD-sku"], ["FF K3"])
  prompt           String  @db.Text
  modelName        String?
  settings         Json? // {modeType, ratio, quality, duration, resolution, ...}
  sourceUrl        String? // for uploads: asset URL to fetch then upload
  creditsEstimated Int     @default(0)
  creditsSpent     Int?

  status      String    @default("queued") // queued|running|completed|failed|skipped
  resultUrl   String? // Cloudinary/blob URL of the downloaded output
  remoteUrl   String? // libtv-hosted asset URL if exposed
  localPath   String?
  error       String?
  attempts    Int       @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([runId, nodeName])
  @@index([runId, status])
  @@index([projectId])
}

model CreativeVariant {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  hookVariant    String
  narrativeType  NarrativeType
  ctaVariant     String
  format         String
  predictedScore Float?
  rationale      String?
  scriptOutline  String?

  createdAt DateTime @default(now())

  @@index([projectId, predictedScore])
}

model PreviewAsset {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  prompt     String
  imageUrl   String?
  style      String?
  dimensions String?
  status     String  @default("pending")

  createdAt DateTime @default(now())
}

model RenderJob {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  kind        String // "import" | "shortsify" | "generate"
  status      String    @default("pending") // pending|running|complete|error
  progress    Float     @default(0)
  currentStep String?
  input       Json
  output      Json?
  error       String?
  outputPath  String?
  durationMs  Int?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId, status])
  @@index([projectId, createdAt])
}

model FalVideoJob {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  falRequestId String @unique
  model        String // "grok-imagine-video" | "wan-2.6" | "kling-v3" | "veo-3.1"
  prompt       String @db.Text
  aspectRatio  String @default("9:16")
  resolution   String @default("720p")
  duration     Int    @default(5) // seconds

  status        String  @default("queued") // queued|processing|completed|failed
  videoUrl      String?
  thumbnailUrl  String?
  fileSizeBytes Int?
  widthPx       Int?
  heightPx      Int?
  fpS           Float?
  durationSec   Float?

  // Script/shot context
  scriptId      String?
  shotIndex     Int?
  promptVersion Int     @default(1)

  costUsd     Float?
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([projectId, status])
  @@index([projectId, createdAt])
}

model VideoReference {
  id             String  @id @default(cuid())
  projectId      String
  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  contentAssetId String? @unique

  sourceUrl   String
  platform    String // tiktok | youtube | douyin | other
  localPath   String?
  durationSec Float?
  width       Int?
  height      Int?
  transcript  String?
  language    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@unique([projectId, sourceUrl])
  @@index([projectId, platform])
}

model ResearchJob {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  status      String    @default("pending")
  progress    Float     @default(0)
  currentStep String?
  steps       Json?
  error       String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([projectId, status])
}

model DeepAnalysis {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  videoStructure   Json?
  vibeAnalysis     Json?
  ctaAnalysis      Json?
  sellingPointDeep Json?
  competitiveGaps  Json?
  recommendations  Json?

  // Extended creative intelligence — added for ad creative production
  environmentAnalysis Json? // [{environment, frequency, description, lightingNotes, examples}]
  cameraAngles        Json? // [{shot, movement, frequency, whenToUse, adEffect, examples}]
  hookFormulas        Json? // [{type, formula, openingLine, why, platformFit, scoreImpact, examples}]
  platformInsights    Json? // [{platform, contentStyle, topFormats, avgEngagement, bestPractices}]
  sellingPointVisuals Json? // [{point, visualTreatment, screenTime, placement, examples}]
  videoTimeline       Json? // {recommendedDurationSec, platform, segments: [{segment, startSec, endSec, label, description, cameraNote, voiceover, purpose}], rationale}

  dataSource DataSource @default(AI_INFERRED)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CampaignSelection {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Selected product focus
  selectedProductName  String?
  selectedProductImage String? // URL of chosen product reference image

  // Selected environment
  selectedEnvironment String? // environment name
  selectedEnvImage    String? // URL of environment reference image
  selectedEnvNotes    String? // lighting/prop notes

  // Selected actor role
  selectedActorRole  String?
  selectedActorImage String? // AI-generated actor appearance image URL
  selectedActorDesc  String? // visual description text
  selectedActorAge   String?

  // Selected selling points (ordered)
  selectedSellingPoints Json? // [{point, priority, visualTreatment}]

  // Video timeline design
  videoTimeline    Json? // [{segment, startSec, endSec, label, description, cameraNote}]
  totalDurationSec Int     @default(30)
  platform         String? // tiktok|instagram|youtube|tvc

  // Reference videos (selected from content page)
  referenceVideoIds Json? // [contentAssetId, ...]

  // Ad style categories the user picked on Insights (src/lib/style-categories.ts)
  styleCategories Json? // string[]

  // Confirmation
  confirmedAt DateTime?
  confirmed   Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AudienceProfile {
  id        String  @id @default(cuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  segments       Json?
  psychographics Json?
  painPoints     Json?
  interests      Json?
  platforms      Json?
  buyingBehavior String?
  incomeLevel    String?
  geoMarkets     Json?

  dataSource DataSource @default(AI_INFERRED)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

// ─── Cross-project learning corpus ───────────────────────────────────────────
// Every video surfaced by ANY search across ANY project accumulates here,
// deduplicated by (platform, videoId) and never cleared. Refreshing or
// regenerating a project upserts into this growing store so prior discoveries —
// and their metrics/scores — are retained for later learning. This is additive,
// not replace-on-refresh.
model DiscoveredVideo {
  id       String @id @default(cuid())
  platform String // youtube | youtube_short | tiktok | vimeo
  videoId  String
  url      String

  title        String
  description  String?   @db.Text
  channelTitle String?
  thumbnailUrl String?
  publishedAt  DateTime?

  viewCount    Int?
  likeCount    Int?
  commentCount Int?

  // Best scoring snapshot seen so far.
  relevanceScore Float?
  qualityScore   Float?
  combinedScore  Float?
  verified       Boolean @default(false)

  // Learning metadata — which brands/searches surfaced this and how often.
  brands      Json? // string[] of brand names that surfaced this video
  workspaceId String?

  seenCount   Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([platform, videoId])
  @@index([workspaceId])
  @@index([combinedScore])
  @@index([platform])
}

// Browser-driven generation jobs — executed by a local worker on the operator's
// Mac controlling logged-in web UIs (Gemini App / Flow / Kling) via browser-harness,
// consuming subscription quota instead of API tokens.
model BrowserGenJob {
  id        String @id @default(cuid())
  projectId String

  kind           String // "image_keyframe" | "video"
  site           String // "ai_studio" (dispatches to Gemini App / gemini.google.com — aistudio.google.com itself requires paid API billing and is not used) | "flow" | "kling"
  model          String? // e.g. "nano-banana-v3", "veo-3.1"
  prompt         String  @db.Text
  negativePrompt String? @db.Text
  inputImageUrl  String? // first-frame conditioning image
  aspectRatio    String  @default("9:16")
  durationSec    Int?

  status    String    @default("queued") // queued|claimed|running|completed|failed
  resultUrl String? // Cloudinary URL after upload
  error     String?
  workerId  String?
  attempts  Int       @default(0)
  claimedAt DateTime?

  // Script/shot context (mirrors FalVideoJob)
  scriptId      String?
  shotIndex     Int?
  promptVersion Int     @default(1)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([status, site])
  @@index([projectId])
  @@index([scriptId])
}
