# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brand_intelligence

# ─── LLMs ────────────────────────────────────────────────────────────────────
# OpenAI powers analysis + gpt-image-1 keyframes.
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o

# Provider order for analyzeWithClaude() is normally OpenAI → Gemini → OpenRouter
# (first one with a working key wins, and a 401/403 disables that provider for
# the process). Set AI_PROVIDER to force a single provider instead, e.g. when
# OPENAI_API_KEY is dead or OPENROUTER_API_KEY is out of balance.
AI_PROVIDER=openai
# openai | gemini | openrouter

# Google GenAI — Veo video generation on the legacy API render path, AND (via
# Gemini's OpenAI-compatible endpoint) a fallback text/vision provider for
# analyzeWithClaude(). GEMINI_API_KEY is optional and only needed if it differs
# from GOOGLE_API_KEY.
GOOGLE_API_KEY=AIza...
GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.8-flash
AI_GEMINI_VISION_MODEL=gemini-3.8-flash

# Groq — Whisper transcription for imported reference videos. Without it,
# transcription silently falls back to OpenAI, and to nothing if that is unset.
GROQ_API_KEY=gsk_...

# Vision model used for ad-teardown keyframe analysis (OpenAI/OpenRouter route
# only — Gemini vision uses AI_GEMINI_VISION_MODEL above).
AI_VISION_MODEL=gpt-4o

# fal.ai — text/image-to-video on the legacy API render path (Grok, Wan, Kling).
FAL_KEY=

# ─── Research ────────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=AIza...

# Meta Ad Library API access token — a standard Graph API app token works for
# ads_archive; no Business Manager approval needed. Instagram oEmbed shares it.
META_ACCESS_TOKEN=

# Per-competitor ranking cut-offs: how many ads survive the gates per
# competitor, and how many of those get the expensive deep teardown.
TOP_N_PER_COMPETITOR=10
TOP_N_DEEP=3

# ─── Object storage ──────────────────────────────────────────────────────────
# Where brand assets, keyframes, clips and masters are hosted. Set ONE of these.
# With neither, uploads fall back to inline data URLs (app) or file:// paths
# (worker) and nothing is shareable.
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# …or the three parts separately:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Vercel Blob alternative — one variable, simplest on Vercel.
BLOB_READ_WRITE_TOKEN=

# ─── Local workers ───────────────────────────────────────────────────────────
# Shared secret checked against the x-worker-token header on
# /api/worker/libtv (LibTV production runs) and used by every local worker.
# Generate with `openssl rand -hex 32`.
WORKER_TOKEN=

# Worker-side only: this Vercel project has Deployment Protection (SSO)
# enabled, so workers must send x-vercel-protection-bypass. Create the secret
# in Vercel → Settings → Deployment Protection → Protection Bypass for
# Automation.
VERCEL_AUTOMATION_BYPASS_SECRET=

# Legacy browser-driven generation worker (AI Studio / Flow web UIs).
BROWSER_WORKER_TOKEN=
BACH_ACCESS_KEY=
BACH_SECRET_KEY=

# Path to the libtv CLI on the operator's Mac (worker-side only).
LIBTV_BIN=/Users/you/.libtv/libtv

# ─── Auth (src/proxy.ts, README "Authentication") ────────────────────────────
# Clerk is the gate when both keys are set; otherwise Cloudflare Access when
# CF_ACCESS_TEAM_DOMAIN + CF_ACCESS_AUD are set; otherwise none.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Comma-separated; these accounts get role "owner" (can open /settings/users).
OWNER_EMAILS=
# Production only: redirect page requests on other hosts (*.vercel.app) here.
AUTH_CANONICAL_HOST=
# Optional override: clerk | cf-access | none
AUTH_PROVIDER=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
CF_ACCESS_HOST=

# ─── Cron ────────────────────────────────────────────────────────────────────
# Vercel Cron auth for /api/cron/poll-video-jobs. Vercel sends this as
# `authorization: Bearer <value>`. Generate with `openssl rand -hex 32`.
CRON_SECRET=

# ─── Feature flags / app ─────────────────────────────────────────────────────
MOCK_CRAWL=false
MOCK_AI=false
NEXT_PUBLIC_APP_NAME=CreativeIntel OS

# ─── LibTV Studio budget + local file serving ────────────────────────────────
# Ceiling for a single compiled run. Compile answers 409 above it unless the
# request sends allowOverBudget. Economy mode puts a 15s board at 76 credits.
LIBTV_MAX_RUN_CREDITS=120

# Only when no cloud storage is configured: the worker's runs directory, served
# by /api/local-files so the dashboard can play masters and previews. Must match
# the worker's LIBTV_RUNS_DIR. The route is disabled in production unless this
# is set; on Vercel prefer CLOUDINARY_URL / BLOB_READ_WRITE_TOKEN instead.
LOCAL_FILES_ROOT=

# Preview deployments require their own DB URL and Clerk pk_test_/sk_test_ keys.
# No production credential fallback is permitted in preview.
# CSP stays report-only until explicitly enforced after a full deployed week.
CSP_MODE=report
CSP_REPORT_STARTED_AT=
DIRECT_DATABASE_URL=

# Optional feature switches / provider settings discovered from source.
# Empty values use documented defaults or leave that integration disabled.
AI_COST_MODE=
AI_DIRECTOR=
AI_FALLBACK_MODEL=
AI_GLM_VISION_MODEL=
ANALYSIS_BUDGET_MS=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
APP_DATABASE_URL=
APP_URL=
ARCHIVE_BLOB_READ_WRITE_TOKEN=
ARTIFACT_ZIP_MAX_BYTES=
AUTOPILOT=
AUTO_HOOK_VARIANTS=
AUTO_REGEN_ON_DRIFT=
BIGMODEL_API_KEY=
BROWSER_FETCH_HOST_INTERVAL_MS=
CACHE_DEFAULT_TTL_SEC=
CI_PRICE_OVERRIDES=
CLIP_DRIFT_QC=
COMFYUI_CF_ACCESS_CLIENT_ID=
COMFYUI_CF_ACCESS_CLIENT_SECRET=
COMFYUI_IMAGE_CHECKPOINT=
COMFYUI_TOKEN=
COMFYUI_URL=
COMFYUI_WORKFLOW_DIR=
CONSISTENCY_QC=
CONSISTENCY_REPAIR=
CONSISTENCY_REROLLS=
CONTENT_SCORING_BATCH=
CREATIVE_STRICT_COMPLIANCE=
EDIT_ENGINE=
EGO_BROWSER_BIN=
FACE_EMBED_URL=
FACE_SAFE_MOTION=
FONTCONFIG_FILE=
FRAME_EXTRACT_BUDGET_MS=
IDEMPOTENCY_TTL_HOURS=
KEYFRAME_QC=
KEYFRAME_QC_REROLLS=
LEGAL_CONTACT_EMAIL=legal@xark.io
LIBTV_MUSIC_FILE=
LIBTV_RUNS_DIR=
MATRIX_API_KEY=
MATRIX_BASE_URL=
MAX_IDLE_POLL_MS=
MEMBER_MONTHLY_ALLOWANCE_USD=1
OPENROUTER_API_KEY=
OPS_AUTO_RECOVER=
PANGOCAIRO_BACKEND=
POLL_INTERVAL_MS=
PRESENTER_CASTING=
PREVIEW_DATABASE_URL=
RESEARCH_CONCURRENCY=
SETTINGS_ENCRYPTION_KEY=
SHOT_DIRECTOR=
SPEND_GUARD=on
TASK_COOLDOWN_MS=
TIKTOK_CREATIVE_CENTER_REGION=
TTS_VOICE=
VIDEO_WORK_DIR=
WORKER_INSTANCE_ID=
WORKER_KINDS=
WORKER_MACHINE_ID=
WORKER_PROCESSES=
WORKER_SITES=
ZHIPU_API_KEY=
