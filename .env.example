# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/brand_intelligence

# OpenAI (powers all AI analysis + image generation)
OPENAI_API_KEY=sk-...
AI_MODEL=gpt-4o

# Optional free-tier fallback if OPENAI_API_KEY is unset or rate-limited —
# routes through OpenRouter's free models (default meta-llama/llama-3.3-70b).
OPENROUTER_API_KEY=
AI_FALLBACK_MODEL=

# YouTube Data API
YOUTUBE_API_KEY=AIza...

# Meta Ad Library API access token — a standard Graph API app token works
# for ads_archive; no Business Manager approval needed. Instagram oEmbed
# also uses this same token.
META_ACCESS_TOKEN=

# Video generation providers (studio video-gen: generate-video route, cron
# poll job). At least one is required for that feature to work.
FAL_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=

# Transcription fallback (services/video/transcribe.ts) — optional, OpenAI
# Whisper is used if unset.
GROQ_API_KEY=

# Cloudinary — used for cloud video import/render when local ffmpeg/ytdlp
# binaries aren't available (e.g. serverless). All three required together.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Product video generation via a local MoneyPrinterTurbo checkout — this
# CANNOT run on Vercel's serverless filesystem. Only set this if you're
# running the app somewhere with a persistent filesystem and a Python venv,
# or routing this feature through a companion worker.
MONEYPRINTER_PATH=
MONEYPRINTER_PYTHON=

# Tuning (all optional, sensible defaults shown)
RESEARCH_CONCURRENCY=5
CACHE_DEFAULT_TTL_SEC=86400
IDEMPOTENCY_TTL_HOURS=24
CONTENT_SCORING_MAX=10
TIKTOK_CREATIVE_CENTER_REGION=US
VIDEO_WORK_DIR=

# Feature flags
MOCK_CRAWL=false
MOCK_AI=false

# App
NEXT_PUBLIC_APP_NAME=CreativeIntel OS

# Browser-driven generation worker (local Mac worker driving AI Studio/Flow/Kling
# web UIs via browser-harness) — shared secret checked against the x-worker-token
# header on /api/worker/browser-jobs. Generate with `openssl rand -hex 32`.
BROWSER_WORKER_TOKEN=

# Vercel Cron auth for /api/cron/poll-video-jobs (server-side video-job
# polling sweep). Vercel sends this as `authorization: Bearer <value>` on
# cron-triggered requests. Generate with `openssl rand -hex 32`.
CRON_SECRET=
